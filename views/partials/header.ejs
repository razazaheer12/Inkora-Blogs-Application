<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== "undefined" && title ? title : site.name %></title>
  <meta
    name="description"
    content="<%= typeof metaDescription !== "undefined" && metaDescription ? metaDescription : site.description %>"
  />
  <meta name="author" content="Raza Zaheer" />
  <meta name="theme-color" content="#f7f2e9" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#131110" media="(prefers-color-scheme: dark)" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..700,0..100,0..1;1,9..144,400..700,0..100,0..1&family=Inter:wght@400..700&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="/styles.css" />

  <script>
    (function () {
      try {
        var stored = localStorage.getItem("inkora-theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.setAttribute(
          "data-theme",
          stored || (prefersDark ? "dark" : "light")
        );
      } catch (err) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <% if (typeof showProgress !== "undefined" && showProgress) { %>
    <div class="progress" aria-hidden="true">
      <div class="progress__bar" data-progress></div>
    </div>
  <% } %>

  <header class="masthead">
    <div class="shell masthead__inner">
      <a class="brand" href="/" aria-label="<%= site.name %> — home">
        <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true">
          <path
            d="M32 6c0 0-15 17.4-15 28a15 15 0 0 0 30 0C47 23.4 32 6 32 6z"
            fill="currentColor"
          />
          <path
            d="M32 22c0 0-6.6 8-6.6 13a6.6 6.6 0 0 0 13.2 0C38.6 30 32 22 32 22z"
            fill="var(--paper)"
            opacity=".9"
          />
          <path d="M18 55h28" stroke="currentColor" stroke-width="4" stroke-linecap="round" opacity=".5" />
        </svg>
        <span class="brand__name">Ink<em>ora</em></span>
      </a>

      <nav class="nav" id="primary-nav" data-nav aria-label="Primary">
        <%
          const isJournal = path === "/" || path.startsWith("/posts/");
          const isAbout = path === "/about";
          const isWriting = path.startsWith("/create") || path.startsWith("/edit/");
        %>
        <a class="nav__link" href="/" <%- isJournal ? 'aria-current="page"' : "" %>>Journal</a>
        <a class="nav__link" href="/about" <%- isAbout ? 'aria-current="page"' : "" %>>About</a>
        <a class="nav__link" href="/create" <%- isWriting ? 'aria-current="page"' : "" %>>Write</a>
      </nav>

      <div class="masthead__actions">
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Switch theme"
        >
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" />
          </svg>
        </button>

        <a class="btn btn--primary btn--sm" href="/create">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14" />
          </svg>
          New post
        </a>

        <button
          class="nav-burger"
          type="button"
          data-nav-toggle
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="primary-nav"
        >
          <span></span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
